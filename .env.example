# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres
POSTGRES_PASSWORD=communa_dev_password

# Only used when running the backend locally via `npm run dev` (outside Docker).
# Inside Docker, docker-compose.yml builds its own DATABASE_URL pointing at the
# `db` service by name instead — this one must point at localhost, and its
# password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://communa:communa_dev_password@localhost:5432/communa

# Backend
JWT_SECRET=replace_with_a_long_random_string
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Bootstrap admin account (created automatically on first backend startup if it doesn't exist)
ADMIN_EMAIL=admin@communa.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Society Admin
