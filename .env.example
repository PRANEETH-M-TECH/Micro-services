# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres
POSTGRES_PASSWORD=communa_dev_password

# Backend
JWT_SECRET=replace_with_a_long_random_string
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Bootstrap admin account (created automatically on first backend startup if it doesn't exist)
ADMIN_EMAIL=admin@communa.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Society Admin
